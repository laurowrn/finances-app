# Copie para .env e ajuste. Usado pelo docker-compose e pelo backend local.

# Segurança
JWT_SECRET=troque-este-segredo
LOGIN_PASSWORD=casal
# IDs autorizados a usar a tela administrativa, separados por vírgula.
ADMIN_USER_IDS=
# Gere com: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
SECRETS_ENCRYPTION_KEY=

# Keycloak/OIDC
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=troque-esta-senha
OIDC_EMAIL_USER_MAP=laurowrn@gmail.com:ID_LAURO,nayarapaolat@gmail.com:ID_NAYARA
OIDC_ISSUER_URL=https://finances.tail1ebd6.ts.net/auth/realms/group-finance
OIDC_INTERNAL_ISSUER_URL=http://keycloak:8080/auth/realms/group-finance
OIDC_CLIENT_ID=group-finance-web
OIDC_ENABLED=false
OIDC_REDIRECT_URI=https://finances.tail1ebd6.ts.net/login
OIDC_ALLOWED_EMAILS=laurowrn@gmail.com,nayarapaolat@gmail.com

# O casal (usados no seed inicial)
USER_A_NAME=Lauro
USER_A_SALARY=5000
USER_B_NAME=Nayara
USER_B_SALARY=3000

# IA (opcional) — sem chave, o "Sugerir regras" apenas agrupa os gastos sem categoria
# e você escolhe a categoria manualmente. Com chave, o Claude pré-preenche a sugestão.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Mongo (padrão do docker-compose)
MONGO_URI=mongodb://localhost:27018
MONGO_DB=group_finance
